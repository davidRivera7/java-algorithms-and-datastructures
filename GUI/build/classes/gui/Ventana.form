                <AuxValue name="JavaCodeGenerator_InitCodePost" type="java.lang.String" value="ListSelectionListener oyenteSeleccion = new ListSelectionListener() {&#xd;&#xa;    @Override&#xd;&#xa;    public void valueChanged(ListSelectionEvent e) {&#xd;&#xa;        if (e.getValueIsAdjusting()) {&#xd;&#xa;        &#xd;&#xa;            int renglon = tabla.getSelectedRow();&#xd;&#xa;                        &#xd;&#xa;            txtFieldNombre.setText(modeloTabla.getValueAt(renglon, 0) + &quot;&quot;);&#xd;&#xa;            txtFieldApellido.setText(modeloTabla.getValueAt(renglon, 1) + &quot;&quot;);&#xd;&#xa;            txtFieldEdad.setText(modeloTabla.getValueAt(renglon, 2) + &quot;&quot;);&#xd;&#xa;            txtFieldCelular.setText(modeloTabla.getValueAt(renglon, 3) + &quot;&quot;);&#xd;&#xa;        &#xd;&#xa;            lblImage.setIcon(&#xd;&#xa;                new ImageIcon(&#xd;&#xa;                new ImageIcon(&quot;src\\gui\\images\\&quot; + txtFieldNombre.getText() + &quot;.png&quot;).getImage()&#xd;&#xa;                        .getScaledInstance(lblImage.getWidth(), lblImage.getHeight(), 0)));        &#xd;&#xa;        }&#xd;&#xa;    }&#xd;&#xa;};&#xd;&#xa;&#xd;&#xa;tabla.getSelectionModel().addListSelectionListener(oyenteSeleccion);"/>
